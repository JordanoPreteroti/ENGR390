<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bz_red"
        android:gravity="center"
        android:padding="14dp"
        android:text="Warning"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvAlertBac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/bz_red_dark"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAlertName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvAlertMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/bz_grey"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCall911"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/bz_red"
            android:text="Call 911"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnSafeRide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/bz_teal_light"
            android:text="Get a safe ride"
            android:textColor="@color/bz_teal_dark" />

        <TextView
            android:id="@+id/btnCloseAlert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:padding="8dp"
            android:text="Close"
            android:textColor="@color/bz_grey" />
    </LinearLayout>
</LinearLayout>
