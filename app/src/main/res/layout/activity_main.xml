<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Device: not connected"
        android:textSize="18sp" />

    <Button
        android:id="@+id/connectButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Connect to device" />

    <TextView
        android:id="@+id/adcText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="MQ-3 raw: --"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/voltText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="MQ-3 voltage: -- V"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/BACRaw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Raw BAC: --"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/bacText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Estimated BAC: --"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tempText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Temperature: -- °C"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/humText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Humidity: -- %"
        android:textSize="20sp" />
</LinearLayout>